{
  "name": "@singseq/bazi-core",
  "version": "0.1.0",
  "type": "module",
  "license": "GPL-3.0-only",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsup src/lib/bazi/index.ts src/lib/bazi/chart.ts src/lib/bazi/compatibility.ts src/lib/bazi/relations.ts src/lib/bazi/relations-analysis.ts src/lib/bazi/research-feature-snapshot.ts src/lib/bazi/research-rules.ts src/lib/bazi/reverse.ts src/lib/bazi/serializer.ts src/lib/bazi/settings.ts src/lib/bazi/shen-sha.ts src/lib/bazi/structure-audit.ts src/lib/bazi/profile.ts --format esm,cjs --dts --clean",
    "prepack": "npm run build"
  },
  "dependencies": {
    "3meta": "https://codeload.github.com/weihaoyang/3meta-patched/tar.gz/97f726c6aba2dbbb4bc9e8c06471f0a2919a89ce",
    "lunar-typescript": "https://codeload.github.com/weihaoyang/lunar-patched/tar.gz/c71ef553dd3540a95805538f27ed2e92a9a49fdf",
    "react": "19.2.4"
  },
  "devDependencies": {
    "@types/react": "^19",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "@types/node": "^20",
    "tsup": "8.5.1"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "LICENSES",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weihaoyang/bazi-core.git"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./chart": {
      "import": {
        "types": "./dist/chart.d.ts",
        "default": "./dist/chart.js"
      },
      "require": {
